{
  "name": "@geckoui/nativewind-rhf",
  "version": "0.1.0",
  "description": "React Hook Form wrappers for @geckoui/nativewind components",
  "license": "MIT",
  "keywords": [
    "react-native",
    "nativewind",
    "react-hook-form",
    "rhf",
    "forms",
    "geckoui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geckoui/geckoui-react-native.git",
    "directory": "packages/nativewind-rhf"
  },
  "homepage": "https://github.com/geckoui/geckoui-react-native/tree/main/packages/nativewind-rhf#readme",
  "bugs": {
    "url": "https://github.com/geckoui/geckoui-react-native/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@geckoui/nativewind": "workspace:*",
    "@types/react": "^19.2.14",
    "nativewind": "^4.2.3",
    "react-hook-form": "^7.65.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@geckoui/nativewind": "workspace:*",
    "nativewind": ">=4",
    "react": ">=18",
    "react-hook-form": ">=7",
    "react-native": ">=0.73"
  }
}
