{
  "name": "@geckoui/nativewind",
  "version": "0.1.0",
  "description": "GeckoUI component library for React Native + NativeWind",
  "license": "MIT",
  "keywords": [
    "react-native",
    "nativewind",
    "tailwind",
    "components",
    "ui",
    "geckoui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geckoui/geckoui-react-native.git",
    "directory": "packages/nativewind"
  },
  "homepage": "https://github.com/geckoui/geckoui-react-native/tree/main/packages/nativewind#readme",
  "bugs": {
    "url": "https://github.com/geckoui/geckoui-react-native/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./preset": "./preset.js"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "preset.js"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "nativewind": "^4.2.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "nativewind": ">=4",
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-safe-area-context": ">=4"
  }
}
