{
  "name": "@geckoui/react-native",
  "version": "0.1.0",
  "description": "GeckoUI component library for React Native",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./preset": "./preset.js"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "preset.js"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "nativewind": "^4.2.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "nativewind": ">=4",
    "react": ">=18",
    "react-native": ">=0.73"
  }
}
